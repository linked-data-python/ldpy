{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: debug ldpy on current file",
            "type": "python",
            "request": "launch",
            "module": "ldpy",
            "justMyCode": true,
            "args": [
                "-s", // show transformed source
                "${file}"
            ]
        },
        {
            "name": "Python: run ldpy on current file",
            "type": "python",
            "request": "launch",
            "module": "ldpy",
            "justMyCode": true,
            "args": [
                "-x", // execute the code
                "-l", // debug the lexer
                "-p", // debug the parser
                //                "-s", // do not print the output
                "-w", // write the output
                "${file}"
            ]
        },
        {
            "name": "Python: Current File",
            "type": "python",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "justMyCode": true,
            "args": [
                "single_input"
            ]
        }
    ]
}